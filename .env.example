# Copy this to .env and set a real random secret before running in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
TASK_TRACKER_SECRET_KEY=replace-with-a-long-random-string

# Unraid only (safe to ignore elsewhere):
# Host port for the app (Unraid's own web GUI uses 80/443, so default here is 8080).
TASK_TRACKER_PORT=8080
# Where container data (SQLite file, Caddy state) lives on the array.
TASK_TRACKER_APPDATA=/mnt/user/appdata/task-tracker
